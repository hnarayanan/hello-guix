;; Test file operations with temporary files. Do not mount filesystems or access devices.

(use-modules (hello-guix installer linux installation-files)
             (guix build utils)
             (guix build syscalls)
             (ice-9 textual-ports)
             (srfi srfi-64))

(define copy-wifi (@@ (hello-guix installer linux installation-files) copy-wifi-settings))
(define save-loader (@@ (hello-guix installer linux installation-files) save-setup-loader))
(define preserve-boot (@@ (hello-guix installer linux installation-files) call-with-preserved-boot-files))
(define directory (mkdtemp! "/tmp/hello-guix-installation-files-XXXXXX"))
(define source (string-append directory "/setup"))
(define target (string-append directory "/target"))
(define wifi-source (string-append source "/var/lib/iwd"))
(define wifi-target (string-append target "/var/lib/iwd"))
(define esp (string-append directory "/efi"))
(define backup (string-append source "/var/lib/hello-guix/setup-bootaa64.efi"))
(define (put name text)
  (mkdir-p (dirname name))
  (call-with-output-file name (lambda (port) (display text port))))
(define (contents name) (call-with-input-file name get-string-all))

(define runner (test-runner-simple))
(test-runner-current runner)
(test-begin "installation-files")
(put (string-append source "/etc/resolv.conf") "# Generated by Connection Manager\nsearch lan\n")
(put (string-append source "/etc/shadow") "setup account sentinel\n")
(put (string-append wifi-source "/Example.psk") "fictional Wi-Fi profile\n")
(put (string-append wifi-source "/Enterprise.8021x") "fictional enterprise profile\n")
(put (string-append wifi-source "/Guest.open") "fictional open network\n")
(put (string-append wifi-source "/cache") "do not carry this across\n")
(copy-wifi wifi-source wifi-target)
(test-equal "network profile content is retained"
  "fictional Wi-Fi profile\n" (contents (string-append wifi-target "/Example.psk")))
(test-assert "only the supported profile types cross the boundary"
  (and (file-exists? (string-append wifi-target "/Enterprise.8021x"))
       (file-exists? (string-append wifi-target "/Guest.open"))
       (not (file-exists? (string-append wifi-target "/cache")))))
(test-equal "profile directory is private" #o700 (stat:perms (stat wifi-target)))
(test-equal "profile file is private" #o600
  (stat:perms (stat (string-append wifi-target "/Example.psk"))))
(test-assert "installer resolver and accounts are not inherited"
  (and (not (file-exists? (string-append target "/etc/resolv.conf")))
       (not (file-exists? (string-append target "/etc/shadow")))))
(test-equal "setup resolver remains untouched"
  "# Generated by Connection Manager\nsearch lan\n"
  (contents (string-append source "/etc/resolv.conf")))
(symlink "/nonexistent-example" (string-append wifi-source "/Link.psk"))
(test-error "source links are rejected" 'misc-error (copy-wifi wifi-source wifi-target))
(delete-file (string-append wifi-source "/Link.psk"))
(delete-file (string-append wifi-target "/Example.psk"))
(symlink "/nonexistent-example" (string-append wifi-target "/Example.psk"))
(test-error "destination links are rejected" 'misc-error (copy-wifi wifi-source wifi-target))

(put (string-append esp "/EFI/BOOT/BOOTAA64.EFI") "setup loader\n")
(save-loader esp backup)
(test-equal "setup loader has a recovery copy" "setup loader\n" (contents backup))
(put (string-append esp "/EFI/BOOT/BOOTAA64.EFI") "partially replaced loader\n")
(save-loader esp backup)
(test-equal "retry preserves the original recovery copy" "setup loader\n" (contents backup))

(for-each (lambda (name) (put (string-append esp "/" name) "Asahi sentinel\n"))
          '("m1n1/boot.bin" "ubootefi.var" "vendorfw/firmware.cpio"))
(test-equal "unchanged early boot files allow completion" 'complete
  (preserve-boot esp (lambda () 'complete)))
(test-error "installation errors propagate" 'example-failure
  (preserve-boot esp (lambda () (throw 'example-failure))))
(test-error "an early boot change prevents successful return" 'misc-error
  (preserve-boot esp
    (lambda () (put (string-append esp "/m1n1/boot.bin") "changed\n"))))
(define support (string-append source "/support"))
(define configuration-directory (string-append target "/etc"))
(define channels (string-append source "/channels.scm"))
(put (string-append support "/modules/example.scm") "example module\n")
(put channels "example channel pins\n")
(mkdir-p configuration-directory)
(prepare-configuration-support support channels configuration-directory)
(test-equal "editable helper module installed" "example module\n"
  (contents (string-append configuration-directory "/hello-guix/modules/example.scm")))
(test-equal "channel pins installed beside configuration" "example channel pins\n"
  (contents (string-append configuration-directory "/channels.scm")))
(prepare-configuration-support support channels configuration-directory)
(test-assert "retry retains ordinary editable files"
  (eq? 'regular (stat:type (lstat (string-append configuration-directory "/channels.scm")))))
(delete-file (string-append configuration-directory "/channels.scm"))
(symlink channels (string-append configuration-directory "/channels.scm"))
(test-error "channel destination cannot redirect writes" 'misc-error
  (prepare-configuration-support support channels configuration-directory))
(delete-file (string-append configuration-directory "/channels.scm"))
(delete-file (string-append configuration-directory "/hello-guix/modules/example.scm"))
(rmdir (string-append configuration-directory "/hello-guix/modules"))
(symlink support (string-append configuration-directory "/hello-guix/modules"))
(test-error "helper directory cannot redirect writes" 'misc-error
  (prepare-configuration-support support channels configuration-directory))
(delete-file-recursively directory)
(test-end "installation-files")
(and (zero? (test-runner-fail-count runner))
     (zero? (test-runner-xpass-count runner)))
